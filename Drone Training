import os
import sys
import time
import numpy as np
import cv2

MODEL = os.path.expanduser("~/autonomous-drone-racing/vision/gate_yolo.onnx")
IMGSZ = 640
CONF_T = 0.40
IOU_T = 0.5

_state = {"mode": None, "sess": None, "net": None}


def _load():
    if _state["mode"]:
        return
    try:
        import onnxruntime as ort
        _state["sess"] = ort.InferenceSession(MODEL, providers=["CPUExecutionProvider"])
        _state["mode"] = "onnxruntime"
    except Exception:
        _state["net"] = cv2.dnn.readNetFromONNX(MODEL)
        _state["mode"] = "cv2.dnn"


def _letterbox(bgr):
    h, w = bgr.shape[:2]
    r = IMGSZ / max(h, w)
    nw, nh = int(round(w * r)), int(round(h * r))
    small = cv2.resize(bgr, (nw, nh))
    left, top = (IMGSZ - nw) // 2, (IMGSZ - nh) // 2
    canvas = np.full((IMGSZ, IMGSZ, 3), 114, np.uint8)
    canvas[top:top + nh, left:left + nw] = small
    return canvas, r, left, top


def _infer(canvas):
    blob = canvas[..., ::-1].astype(np.float32) / 255.0
    blob = np.ascontiguousarray(blob.transpose(2, 0, 1)[None])
    if _state["mode"] == "onnxruntime":
        s = _state["sess"]
        return s.run(None, {s.get_inputs()[0].name: blob})[0]
    _state["net"].setInput(blob)
    return _state["net"].forward()


def _nms(boxes, scores, thr):
    order = np.argsort(-scores)
    keep = []
    while len(order):
        i = order[0]
        keep.append(int(i))
        rest = order[1:]
        if len(rest) == 0:
            break
        x1 = np.maximum(boxes[i, 0], boxes[rest, 0])
        y1 = np.maximum(boxes[i, 1], boxes[rest, 1])
        x2 = np.minimum(boxes[i, 0] + boxes[i, 2], boxes[rest, 0] + boxes[rest, 2])
        y2 = np.minimum(boxes[i, 1] + boxes[i, 3], boxes[rest, 1] + boxes[rest, 3])
        inter = np.clip(x2 - x1, 0, None) * np.clip(y2 - y1, 0, None)
        union = boxes[i, 2] * boxes[i, 3] + boxes[rest, 2] * boxes[rest, 3] - inter
        order = rest[inter / np.maximum(union, 1e-9) < thr]
    return keep


def detect_all(bgr):
    """All gates after NMS: list of (x, y, w, h, conf) in original image pixels"""
    _load()
    H, W = bgr.shape[:2]
    canvas, r, left, top = _letterbox(bgr)
    out = np.squeeze(np.asarray(_infer(canvas)), 0)
    if out.shape[-1] == 6:                       # built-in NMS: x1,y1,x2,y2,score,cls
        rows = out[out[:, 4] >= CONF_T]
        if len(rows) == 0:
            return []
        boxes = np.array([[a, b, c - a, d - b] for a, b, c, d in rows[:, :4]])
    else:                                        # cx,cy,w,h,score
        if out.shape[0] < out.shape[1]:
            out = out.T
        rows = out[out[:, 4] >= CONF_T]
        if len(rows) == 0:
            return []
        boxes = np.array([[cx - w / 2, cy - h / 2, w, h] for cx, cy, w, h in rows[:, :4]])
    scores = rows[:, 4]
    res = []
    for i in _nms(boxes, scores, IOU_T):
        x, y, bw, bh = boxes[i]
        x1 = max(0.0, (x - left) / r)
        y1 = max(0.0, (y - top) / r)
        x2 = min(float(W), (x + bw - left) / r)
        y2 = min(float(H), (y + bh - top) / r)
        if x2 - x1 > 1 and y2 - y1 > 1:
            res.append((float(x1), float(y1), float(x2 - x1), float(y2 - y1), float(scores[i])))
    return res


def detect(bgr):
    """Target = nearest gate (largest box). Returns (info, None)."""
    H, W = bgr.shape[:2]
    gates = detect_all(bgr)
    if not gates:
        return {"detected": False, "cx": 0.0, "cy": 0.0, "w_frac": 0.0,
                "h_frac": 0.0, "conf": 0.0, "box": None, "n_gates": 0}, None
    x1, y1, bw, bh, conf = max(gates, key=lambda g: g[2] * g[3])
    return {
        "detected": True,
        "cx": float(((x1 + bw / 2) - W / 2) / (W / 2)),
        "cy": float(((y1 + bh / 2) - H / 2) / (H / 2)),
        "w_frac": float(bw / W),
        "h_frac": float(bh / H),
        "conf": conf,
        "box": (int(x1), int(y1), int(bw), int(bh)),
        "n_gates": len(gates),
    }, None


if __name__ == "__main__":
    path = sys.argv[1] if len(sys.argv) > 1 else "/tmp/frame.png"
    bgr = cv2.imread(path)
    if bgr is None:
        raise SystemExit("cannot read " + path)
    detect(bgr)
    t = time.time()
    for _ in range(5):
        info, _ = detect(bgr)
    ms = (time.time() - t) / 5 * 1000
    print("backend:", _state["mode"], f"| {ms:.0f} ms/frame")
    gates = detect_all(bgr)
    print("gates found:", len(gates))
    for g in sorted(gates, key=lambda g: -g[2] * g[3]):
        print("  box=(%d,%d,%d,%d) conf=%.2f" % (g[0], g[1], g[2], g[3], g[4]))
    print("target:", {k: (round(v, 3) if isinstance(v, float) else v) for k, v in info.items()})
    for g in gates:
        x, y, w, h, _c = [int(v) for v in g]
        cv2.rectangle(bgr, (x, y), (x + w, y + h), (0, 255, 255), 2)
    if info["box"]:
        x, y, w, h = info["box"]
        cv2.rectangle(bgr, (x, y), (x + w, y + h), (0, 255, 0), 4)
    cv2.imwrite("/tmp/yolo_detected.png", bgr)
    print("saved /tmp/yolo_detected.png")
EOF

