            print(f"wall={now:.0f}s altitude={alt:.2f} m", flush=True)
        if alt >= TARGET_ALT - 0.3:
            print("-- Reached target altitude")
            break
        if now > TIMEOUT:
            print("-- Timeout")
            break

    await asyncio.sleep(10)
    print("-- Landing")
    await drone.action.land()
    async for in_air in drone.telemetry.in_air():
        if not in_air:
            break
    print("Done")


