cat > ~/autonomous-drone-racing/control/race_controller.py << 'EOF'
import asyncio
import json
import math
import os
import socket
import time
from mavsdk import System
from mavsdk.offboard import OffboardError, VelocityBodyYawspeed

# ---------- settings (starting values, tune after testing) ----------
TARGET_ALT = 2.0
V_MAX = float(os.environ.get("V_MAX", "1.0"))
MAX_GATES = int(os.environ.get("MAX_GATES", "99"))
V_SEARCH = 0.5
K_YAW = 30.0
K_Z = 1.0
V_Z_MAX = 0.8
COMMIT_W = 0.45        # gate width in image that triggers the final dash (~3.5 m)
COMMIT_DIST = 4.5      # straight-through distance after commit
LOOP_HZ = 20
STALE_S = 1.0
MIN_CONF = 0.5
FIRST_GATE_TIMEOUT = 20.0
LOST_FINISH_S = 25.0
TOTAL_TIMEOUT = 1500.0

# gate positions of the current world: used only to SCORE a run afterwards
REF = [(14.0, 0.0, 2.25), (28.0, 1.5, 3.35), (42.0, -1.45, 2.05),
       (56.0, 1.8, 3.65), (70.0, -0.5, 2.55)]


def clamp(x, lo, hi):
    return max(lo, min(hi, x))


class GateFeed:
    """Receives vision results over UDP from vision_server_yolo.py"""

    def __init__(self, port=5005):
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.bind(("127.0.0.1", port))
        self.sock.setblocking(False)
        self.info = None

    def fresh(self):
        while True:
            try:
                data, _ = self.sock.recvfrom(4096)
            except BlockingIOError:
                break
            self.info = json.loads(data)
        i = self.info
        if (i is None or not i["detected"] or i["conf"] < MIN_CONF
                or time.time() - i["t"] > STALE_S):
            return None
        return i


async def track_position(drone, pos):
    async for pv in drone.telemetry.position_velocity_ned():
        pos["n"] = pv.position.north_m
        pos["e"] = pv.position.east_m
        pos["d"] = pv.position.down_m


async def land(drone):
    try:
        await drone.offboard.stop()
    except OffboardError:
        pass
    await drone.action.land()

    async def wait_ground():
        async for in_air in drone.telemetry.in_air():
            if not in_air:
                return
    try:
        await asyncio.wait_for(wait_ground(), 180)
    except asyncio.TimeoutError:
        print("landing timeout")


def check_pass(k, samples):
    """Rough score: where was the drone when it crossed gate k's plane"""
    if k >= len(REF):
        return None
    gx, gy, gz = REF[k]
    for n, e, alt in samples:
        if e >= gx:
            dn, dz = n - gy, alt - gz
            return (dn, dz, abs(dn) < 1.4 and abs(dz) < 1.1)
    return "no_plane"


async def run():
    feed = GateFeed()
    drone = System()
    await drone.connect(system_address="udpin://0.0.0.0:14540")
    async for state in drone.core.connection_state():
        if state.is_connected:
            print("-- Connected")
            break
    async for health in drone.telemetry.health():
        if health.is_global_position_ok and health.is_home_position_ok:
            break

    pos = {}
    tracker = asyncio.create_task(track_position(drone, pos))
    wall0 = time.time()
    try:
        print("-- Arming / Taking off")
        await drone.action.arm()
        await drone.action.takeoff()
        t0 = time.time()
        while -pos.get("d", 0.0) < TARGET_ALT:
            if time.time() - t0 > 150:
                print("-- Takeoff timeout")
                return
            await asyncio.sleep(0.2)
        print("-- At altitude, starting offboard")

        await drone.offboard.set_velocity_body(VelocityBodyYawspeed(0, 0, 0, 0))
        try:
            await drone.offboard.start()
        except OffboardError as e:
            print(f"Offboard failed: {e._result.result}")
            return

        n0, e0 = pos["n"], pos["e"]
        phase, passed, commit_from = "approach", 0, None
        samples, checks = [], []
        sm = {"t": 0.0, "n": 0, "cx": 0.0, "cy": 0.0, "w": 0.0}
        last_seen = time.time()
        t_race, last_log, dt = time.time(), 0.0, 1.0 / LOOP_HZ
        reason = "timeout"

        while time.time() - t_race < TOTAL_TIMEOUT:
            now = time.time()
            cmd = (0.0, 0.0, 0.0, 0.0)
            if phase == "approach":
                info = feed.fresh()
                if info is None:
                    sm["n"] = 0
                    lost = now - last_seen
                    if passed == 0 and lost > FIRST_GATE_TIMEOUT:
                        reason = "no gate found at start"
                        break
                    if passed > 0 and lost > LOST_FINISH_S:
                        reason = "no more gates"
                        break
                    if passed > 0 and lost > 2.0:
                        cmd = (V_SEARCH, 0.0, 0.0, 0.0)
                else:
                    last_seen = now
                    if info["t"] != sm["t"]:
                        a = 1.0 if sm["n"] == 0 else 0.5
                        sm["cx"] += a * (info["cx"] - sm["cx"])
                        sm["cy"] += a * (info["cy"] - sm["cy"])
                        sm["w"] += a * (info["w_frac"] - sm["w"])
                        sm["t"] = info["t"]
                        sm["n"] += 1
                    cx, cy, w = sm["cx"], sm["cy"], sm["w"]
                    aligned = abs(cx) < 0.12 and abs(cy) < 0.2
                    if w >= COMMIT_W and aligned:
                        phase = "commit"
                        commit_from = (pos["n"], pos["e"])
                        samples = []
                        print(f"-- COMMIT gate {passed + 1}: w={w:.2f} cx={cx:.2f} cy={cy:.2f}")
                        cmd = (V_MAX, 0.0, 0.0, 0.0)
                    else:
                        slow = max(0.2, 1.0 - 2.0 * max(abs(cx), abs(cy)))
                        if w >= COMMIT_W:
                            slow = min(slow, 0.2)
                        cmd = (V_MAX * slow, 0.0,
                               clamp(K_Z * cy, -V_Z_MAX, V_Z_MAX), K_YAW * cx)
                    if now - last_log > 1.0:
                        last_log = now
                        print(f"approach cx={cx:.2f} cy={cy:.2f} w={w:.2f} "
                              f"n_gates={info.get('n_gates', '?')} alt={-pos['d']:.2f}")
            else:
                samples.append((pos["n"] - n0, pos["e"] - e0, -pos["d"]))
                dist = math.hypot(pos["n"] - commit_from[0], pos["e"] - commit_from[1])
                cmd = (V_MAX, 0.0, 0.0, 0.0)
                if dist >= COMMIT_DIST:
                    passed += 1
                    checks.append(check_pass(passed - 1, samples))
                    print(f"-- Gate {passed} passed after {dist:.1f} m")
                    phase, last_seen, sm["n"] = "approach", now, 0
                    cmd = (0.0, 0.0, 0.0, 0.0)
                    if passed >= MAX_GATES:
                        reason = "reached MAX_GATES"
                        break

            await drone.offboard.set_velocity_body(VelocityBodyYawspeed(*cmd))
            await asyncio.sleep(dt)

        await drone.offboard.set_velocity_body(VelocityBodyYawspeed(0, 0, 0, 0))
        print(f"\n-- Finished: {reason}; gates passed (by controller): {passed}")
        ok_all = True
        for k, c in enumerate(checks):
            if c is None:
                print(f"   gate {k + 1}: no reference position")
            elif c == "no_plane":
                print(f"   gate {k + 1}: never crossed the reference plane")
                ok_all = False
            else:
                print(f"   gate {k + 1}: dn={c[0]:+.2f} m  dz={c[1]:+.2f} m  "
                      f"{'OK' if c[2] else 'MISS'}")
                ok_all = ok_all and c[2]
        need = min(MAX_GATES, len(REF))
        success = passed >= need and ok_all
        print(f"-- RESULT: {'SUCCESS' if success else 'FAIL'} "
              f"(passed {passed}/{need}, V_MAX={V_MAX})")
        rdir = os.path.expanduser("~/autonomous-drone-racing/results")
        os.makedirs(rdir, exist_ok=True)
        with open(os.path.join(rdir, "race_runs.csv"), "a") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')},{passed},{need},"
                    f"{int(success)},{V_MAX},{time.time() - wall0:.0f},{reason}\n")
        print("-- Landing")
        await land(drone)
        print("Done")
    finally:
        tracker.cancel()


asyncio.run(run())
