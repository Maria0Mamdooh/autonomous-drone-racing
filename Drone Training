import math
import os
import random
import subprocess
import sys
import time
import numpy as np
import cv2
from gz.transport13 import Node
from gz.msgs10.image_pb2 import Image
from gz.msgs10.pose_v_pb2 import Pose_V

WORLD = "tuwaiq_p1_challenge"
IMG_TOPIC = f"/world/{WORLD}/model/x500_mono_cam_0/link/camera_link/sensor/camera/image"
DYN_TOPIC = f"/world/{WORLD}/dynamic_pose/info"
POSE_TOPIC = f"/world/{WORLD}/pose/info"
OUT = os.path.expanduser("~/autonomous-drone-racing/dataset_world")
DONE = "/tmp/dataset_done"
N_BASE = int(sys.argv[1]) if len(sys.argv) > 1 else 10
VARIANTS = 4

FX = FY = 539.9363
CX0, CY0 = 640.0, 480.0
CAM_OFF = np.array([0.12, 0.03, 0.242])
DRONE = "x500_mono_cam_0"
GATES = ["gate_01", "gate_02", "gate_03", "gate_04", "gate_05"]
ORIG = {
    "gate_01": (14.0, 0.0, 2.25, 0.0535203),
    "gate_02": (28.0, 1.5, 3.35, -0.0517395),
    "gate_03": (42.0, -1.45, 2.05, 0.0107139),
    "gate_04": (56.0, 1.8, 3.65, 0.1735419),
    "gate_05": (70.0, -0.5, 2.55, -0.0641974),
}
# gate frame bars (center, size) in the gate's local frame
BARS = [((0, 0, 1.52), (0.16, 3.8, 0.16)), ((0, 0, -1.52), (0.16, 3.8, 0.16)),
        ((0, -1.82, 0), (0.16, 0.16, 3.06)), ((0, 1.82, 0), (0.16, 0.16, 3.06))]
OUTER_HX, OUTER_HY, OUTER_Z0, OUTER_Z1 = 0.08, 1.9, -1.6, 1.65

rng = random.Random(1)
img_state = {"img": None, "n": 0}
drone_pose = {}


def on_image(msg):
    img_state["img"] = np.frombuffer(msg.data, dtype=np.uint8).reshape(msg.height, msg.width, 3)
    img_state["n"] += 1


def on_pose(msg):
    for p in msg.pose:
        if p.name == DRONE:
            drone_pose["p"] = (
                np.array([p.position.x, p.position.y, p.position.z]),
                np.array([p.orientation.w, p.orientation.x, p.orientation.y, p.orientation.z]))


def wait_for(cond, timeout):
    t0 = time.time()
    while time.time() - t0 < timeout:
        if cond():
            return True
        time.sleep(0.1)
    return False


def quat_R(q):
    w, x, y, z = q / np.linalg.norm(q)
    return np.array([
        [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
        [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
        [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)]])


def Rz(a):
    c, s = math.cos(a), math.sin(a)
    return np.array([[c, -s, 0], [s, c, 0], [0, 0, 1]])


def camera_pose():
    t, q = drone_pose["p"]
    R = quat_R(q)
    return t + R @ CAM_OFF, R


def box_pts(c, s):
    hx, hy, hz = s[0] / 2, s[1] / 2, s[2] / 2
    return np.array([[c[0] + a * hx, c[1] + b * hy, c[2] + d * hz]
                     for a in (-1, 1) for b in (-1, 1) for d in (-1, 1)])


def project(pw, tc, Rc, s):
    pc = (pw - tc) @ Rc
    d = pc[:, 0]
    safe = np.where(np.abs(d) < 1e-6, 1e-6, d)
    u = (CX0 - FX * pc[:, 1] / safe) * s
    v = (CY0 - FY * pc[:, 2] / safe) * s
    return np.stack([u, v], 1), d


def analyze(pos, yaw, tc, Rc, W, H):
    s = W / 1280.0
    loc = box_pts((0, 0, (OUTER_Z0 + OUTER_Z1) / 2),
                  (2 * OUTER_HX, 2 * OUTER_HY, OUTER_Z1 - OUTER_Z0))
    uv, d = project(pos + loc @ Rz(yaw).T, tc, Rc, s)
    if np.all(d <= 0.3):
        return "invisible", None
    if np.any(d <= 0.3):
        return "ambiguous", None
    x0, y0 = uv.min(0)
    x1, y1 = uv.max(0)
    area = max((x1 - x0) * (y1 - y0), 1e-6)
    bx0, by0, bx1, by1 = max(x0, 0), max(y0, 0), min(x1, W), min(y1, H)
    if bx1 <= bx0 or by1 <= by0:
        return "invisible", None
    frac = ((bx1 - bx0) * (by1 - by0)) / area
    if frac < 0.02:
        return "invisible", None
    if frac >= 0.6 and (bx1 - bx0) >= 20 * s and (by1 - by0) >= 20 * s:
        return "ok", {"box": (bx0, by0, bx1, by1), "frac": frac, "depth": float(d.mean())}
    return "ambiguous", None


def bar_mask(pos, yaw, tc, Rc, W, H):
    s = W / 1280.0
    m = np.zeros((H, W), np.uint8)
    for c, sz in BARS:
        uv, d = project(pos + box_pts(c, sz) @ Rz(yaw).T, tc, Rc, s)
        if np.any(d <= 0.3):
            continue
        hull = cv2.convexHull(uv.astype(np.float32))
        cv2.fillConvexPoly(m, np.round(hull).astype(np.int32), 255)
    return m


def run_set_pose(reqs):
    procs = []
    for name, (pos, yaw) in reqs.items():
        req = (f'name: "{name}", position: {{x: {pos[0]:.4f}, y: {pos[1]:.4f}, z: {pos[2]:.4f}}}, '
               f'orientation: {{w: {math.cos(yaw / 2):.6f}, z: {math.sin(yaw / 2):.6f}}}')
        procs.append(subprocess.Popen(
            ["gz", "service", "-s", f"/world/{WORLD}/set_pose",
             "--reqtype", "gz.msgs.Pose", "--reptype", "gz.msgs.Boolean",
             "--timeout", "3000", "--req", req],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True))
    ok = True
    for p in procs:
        try:
            out, _ = p.communicate(timeout=30)
            ok = ok and ("true" in out)
        except subprocess.TimeoutExpired:
            p.kill()
            ok = False
    return ok


def key(v):
    return (tuple(np.round(v[0], 4)), round(float(v[1]), 5))


def make_config(tc, Rc):
    yaw0 = math.atan2(Rc[1, 0], Rc[0, 0])
    c, s_ = math.cos(yaw0), math.sin(yaw0)
    r = rng.random()
    n = 0 if r < 0.10 else (1 if r < 0.55 else (2 if r < 0.85 else 3))
    cfg = {}
    d = math.exp(rng.uniform(math.log(2.5), math.log(25)))
    for name in rng.sample(GATES, n):
        if d > 45:
            break
        lat = rng.uniform(-0.8, 0.8) * 1.185 * d
        x = tc[0] + d * c - lat * s_
        y = max(-8.5, min(8.5, tc[1] + d * s_ + lat * c))
        z = rng.uniform(1.8, 4.0)
        yaw = yaw0 + math.radians(rng.uniform(-65, 65))
        cfg[name] = (np.array([x, y, z]), yaw)
        d += rng.uniform(6, 16)
    parked = [g for g in GATES if g not in cfg]
    for i, g in enumerate(parked):
        cfg[g] = (np.array([-40.0 - 8 * i, 0.0, 2.0]), 0.0)
    return cfg


def grab_after(min_new=6, timeout=40):
    n0, t0 = img_state["n"], time.time()
    while img_state["n"] < n0 + min_new:
        if time.time() - t0 > timeout:
            return None
        time.sleep(0.03)
    return img_state["img"].copy()


def recolor(bgr, masks):
    hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
    colored = (hsv[..., 2] > 110) & (hsv[..., 1] > 80)
    for m in masks:
        sel = (cv2.dilate(m, np.ones((3, 3), np.uint8)) > 0) & colored
        if rng.random() < 0.12:      # white / gray
            s, f = rng.randint(0, 30), rng.uniform(0.4, 1.0)
        else:                        # random vivid color
            s, f = rng.randint(130, 255), rng.uniform(0.55, 1.0)
        hsv[..., 0][sel] = rng.randint(0, 179)
        hsv[..., 1][sel] = s
        hsv[..., 2][sel] = np.clip(hsv[..., 2][sel].astype(np.float32) * f, 0, 255).astype(np.uint8)
    return cv2.cvtColor(hsv, cv2.COLOR_HSV2BGR)


def jitter(bgr):
    a, b = rng.uniform(0.7, 1.3), rng.uniform(-20, 20)
    out = np.clip(bgr.astype(np.float32) * a + b, 0, 255)
    sigma = rng.uniform(0, 6)
    if sigma > 0.5:
        out += np.random.default_rng(rng.randint(0, 10 ** 6)).normal(0, sigma, out.shape)
    return np.clip(out, 0, 255).astype(np.uint8)


def main():
    for sp in ("train", "val"):
        os.makedirs(f"{OUT}/images/{sp}", exist_ok=True)
        os.makedirs(f"{OUT}/labels/{sp}", exist_ok=True)
    os.makedirs(f"{OUT}/preview", exist_ok=True)
    if os.path.exists(DONE):
        os.remove(DONE)

    node = Node()
    if not node.subscribe(Image, IMG_TOPIC, on_image):
        raise SystemExit("image subscribe failed")
    node.subscribe(Pose_V, DYN_TOPIC, on_pose)
    if not wait_for(lambda: "p" in drone_pose, 10):
        node.subscribe(Pose_V, POSE_TOPIC, on_pose)
        if not wait_for(lambda: "p" in drone_pose, 15):
            raise SystemExit("no drone pose received")
    if not wait_for(lambda: img_state["img"] is not None, 60):
        raise SystemExit("no camera frames")
    tc, Rc = camera_pose()
    print(f"camera at x={tc[0]:.2f} y={tc[1]:.2f} z={tc[2]:.2f} "
          f"heading={math.degrees(math.atan2(Rc[1, 0], Rc[0, 0])):.1f} deg")
    if tc[2] < 1.2:
        raise SystemExit("drone is not hovering: run hover_for_dataset.py first")

    cur = {g: (np.array(ORIG[g][:3]), ORIG[g][3]) for g in GATES}
    skips = {"move": 0, "frame": 0, "unstable": 0, "ambiguous": 0, "coverage": 0}
    covs, base, attempts, files, n_labels, n_empty = [], 0, 0, 0, 0, 0
    prev_l, prev_n, t_start = 0, 0, time.time()
    try:
        while base < N_BASE and attempts < N_BASE * 6:
            attempts += 1
            tc, Rc = camera_pose()
            cfg = make_config(tc, Rc)
            changed = {g: v for g, v in cfg.items() if g not in cur or key(cur[g]) != key(v)}
            if changed:
                if not run_set_pose(changed):
                    for g in changed:
                        cur.pop(g, None)
                    skips["move"] += 1
                    continue
                cur.update(changed)
            tcA, RcA = camera_pose()
            frame = grab_after(6)
            if frame is None:
                skips["frame"] += 1
                continue
            tcB, RcB = camera_pose()
            if np.linalg.norm(tcB - tcA) > 0.03 or np.linalg.norm(RcB - RcA) > 0.012:
                skips["unstable"] += 1
                continue

            H, W = frame.shape[:2]
            bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
            labeled, ambiguous = [], False
            for g in GATES:
                st, info = analyze(cur[g][0], cur[g][1], tcB, RcB, W, H)
                if st == "ambiguous":
                    ambiguous = True
                    break
                if st == "ok":
                    labeled.append((g, info))
            if ambiguous:
                skips["ambiguous"] += 1
                continue

            hsv0 = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV)
            colored0 = (hsv0[..., 2] > 140) & (hsv0[..., 1] > 100)
            masks, bad = [], False
            for g, info in labeled:
                m = bar_mask(cur[g][0], cur[g][1], tcB, RcB, W, H)
                masks.append(m)
                if info["depth"] <= 8 and info["frac"] >= 0.95 and (m > 0).any():
                    cov = float(colored0[m > 0].mean())
                    covs.append(cov)
                    if cov < 0.5:
                        bad = True
            if bad:
                skips["coverage"] += 1
                continue

            split = "val" if base % 7 == 0 else "train"
            for v in range(VARIANTS if labeled else 2):
                img = bgr if v == 0 else recolor(bgr, masks)
                img = jitter(img)
                boxes = [(((b[0] + b[2]) / 2) / W, ((b[1] + b[3]) / 2) / H,
                          (b[2] - b[0]) / W, (b[3] - b[1]) / H)
                         for b in (info["box"] for _, info in labeled)]
                if rng.random() < 0.5:
                    img = cv2.flip(img, 1)
                    boxes = [(1 - cx, cy, bw, bh) for cx, cy, bw, bh in boxes]
                small = cv2.resize(img, (W // 2, H // 2), interpolation=cv2.INTER_AREA)
                name = f"w{base:04d}_{v}"
                cv2.imwrite(f"{OUT}/images/{split}/{name}.jpg", small, [cv2.IMWRITE_JPEG_QUALITY, 92])
                with open(f"{OUT}/labels/{split}/{name}.txt", "w") as f:
                    for cx, cy, bw, bh in boxes:
                        f.write(f"0 {cx:.6f} {cy:.6f} {bw:.6f} {bh:.6f}\n")
                files += 1
                n_labels += len(boxes)
                if not boxes:
                    n_empty += 1
                if v < 2 and ((boxes and prev_l < 16) or (not boxes and prev_n < 3)):
                    pv = small.copy()
                    h_, w_ = pv.shape[:2]
                    for cx, cy, bw, bh in boxes:
                        cv2.rectangle(pv, (int((cx - bw / 2) * w_), int((cy - bh / 2) * h_)),
                                      (int((cx + bw / 2) * w_), int((cy + bh / 2) * h_)), (0, 255, 0), 2)
                    cv2.imwrite(f"{OUT}/preview/{name}.jpg", pv)
                    if boxes:
                        prev_l += 1
                    else:
                        prev_n += 1
            base += 1
            ds = ",".join(f"{info['depth']:.0f}" for _, info in labeled) or "-"
            print(f"[{base}/{N_BASE}] gates={len(labeled)} depth(m)={ds} "
                  f"({time.time() - t_start:.0f}s)", flush=True)
    finally:
        run_set_pose({g: (np.array(ORIG[g][:3]), ORIG[g][3]) for g in GATES})
        with open(f"{OUT}/data.yaml", "w") as f:
            f.write(f"path: {OUT}\ntrain: images/train\nval: images/val\nnames:\n  0: gate\n")
        open(DONE, "w").close()
        print(f"done: {base} base frames, {files} images, {n_labels} gate labels, "
              f"{n_empty} empty images, {attempts} attempts")
        print("skipped:", skips)
        if covs:
            print(f"mean color coverage {np.mean(covs):.2f} over {len(covs)} checks")


main()
EOF
// What it does:
//• Moves 0 to 3 gates to random positions, heights and angles in front of the hovering drone 
//(some images have no gate at all, so the model learns that cyan/purple walls are not gates).
//• Reads the drone pose from Gazebo and projects each gate's 3D frame into the image to get an exact bounding box (YOLO label format). 
//Ambiguous cases (gate cut by the image edge, behind the camera) are skipped.
//• Makes 4 variants per frame: random gate colors (including white and gray), brightness, noise, and horizontal flip. Colors are applied with a mask computed from geometry.
//• Splits images into train/val (every 7th base frame goes to val), halves the resolution to 640×480 to save space, saves labeled previews, and always puts the gates back in their original places at the end.

